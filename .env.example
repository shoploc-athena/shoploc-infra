# Copy this file to .env and set real values.
# The .env file is ignored by Git: never commit it.

# PostgreSQL administrator (creates the databases at first start)
POSTGRES_DB=postgres
POSTGRES_USER=shoploc
POSTGRES_PASSWORD=change-me

# One database user per service instance (Lille)
USER_LILLE_DB_PASSWORD=change-me
STORE_LILLE_DB_PASSWORD=change-me
ORDER_LILLE_DB_PASSWORD=change-me