# Copy this file to .env and set real values.
# The .env file is ignored by Git: never commit it.

# PostgreSQL administrator (creates the databases at first start)
POSTGRES_DB=postgres
POSTGRES_USER=shoploc
POSTGRES_PASSWORD=change-me

# One database user per service instance (Lille)
USER_LILLE_DB_PASSWORD=change-me
STORE_LILLE_DB_PASSWORD=change-me
ORDER_LILLE_DB_PASSWORD=change-me

# Shared by the services that verify the JWT (generate with: openssl rand -base64 48)
JWT_SECRET=change-me

# First association account, created by user-service at startup (password: 12 characters minimum)
ASSOCIATION_ADMIN_EMAIL=change-me@example.org
ASSOCIATION_ADMIN_PASSWORD=change-me